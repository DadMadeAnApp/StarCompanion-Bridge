# TLS material and pairing secret — never commit these
*.pem
bridge_token.txt

# Retired opt-out of authentication. The bridge now refuses to start when this
# file is present; keep it ignored so a leftover copy is never committed.
INSECURE_NO_AUTH

# Build output
build/
dist/
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
